# =========================================================================
# SwasthAI Report Generator - Backend Environment Configuration Template
# Copy this file to .env and replace all placeholders with secure production values.
# NEVER commit the actual .env file or production secrets to source control.
# =========================================================================

# --- SERVER CONFIGURATION ---
SERVER_PORT=8087

# --- POSTGRESQL DATABASE ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=swasthai_report_generator
DB_USERNAME=postgres
DB_PASSWORD=your_secure_database_password

# --- ASYMMETRIC RSA JWT AUTHENTICATION ---
# Path to PKCS#8 RSA private key PEM file for signing tokens
JWT_PRIVATE_KEY_PATH=/path/to/private.pem
# Path to X.509 RSA public key PEM file for verifying tokens
JWT_PUBLIC_KEY_PATH=/path/to/public.pem
# Token validity in seconds (900s = 15 minutes)
JWT_ACCESS_TOKEN_EXPIRATION_SECONDS=900
JWT_ISSUER=swasthai-report-generator

# --- INITIAL ROOT SUPER ADMIN BOOTSTRAP ---
# Set to true ONLY during initial deployment to provision the root admin account
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=admin@yourlaboratory.com
BOOTSTRAP_ADMIN_PASSWORD=your_strong_bootstrap_password
BOOTSTRAP_ADMIN_NAME=System Super Admin

# --- CORS ALLOWED ORIGINS ---
# Comma-separated list of allowed frontend origins (e.g. https://app.yourlaboratory.com)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# --- STORAGE ---
# Local persistent mount or network path for doctor signatures and laboratory logos
STORAGE_ROOT_PATH=/var/swasthai/storage
STORAGE_MAX_IMAGE_SIZE_BYTES=5242880

# --- REPORT RETENTION & PURGE POLICIES ---
REPORT_RETENTION_DELETE_AFTER_DAYS=5
REPORT_RETENTION_PURGE_AFTER_DAYS=10
REPORT_RETENTION_PURGE_BATCH_SIZE=500
REPORT_RETENTION_PURGE_ENABLED=true
REPORT_RETENTION_PURGE_CRON=0 0 3 * * *
REPORT_RETENTION_TIME_ZONE=Asia/Kolkata

# --- AUTH BRUTE-FORCE RATE LIMITING ---
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_LOCK_SECONDS=300
AUTH_RATE_LIMIT_CLEANUP_ENABLED=true
AUTH_RATE_LIMIT_CLEANUP_CRON=0 0 * * * *
AUTH_RATE_LIMIT_CLEANUP_BATCH_SIZE=500
AUTH_RATE_LIMIT_CLEANUP_STALE_AFTER_SECONDS=86400

# --- LAB STAFF CLEANUP SCHEDULER ---
STAFF_CLEANUP_ENABLED=true
STAFF_CLEANUP_CRON=0 0 2 * * *
STAFF_CLEANUP_TIME_ZONE=Asia/Kolkata
STAFF_CLEANUP_RETENTION_DAYS=10
STAFF_CLEANUP_BATCH_SIZE=50

# --- SUBSCRIPTION & LICENSING ---
SUBSCRIPTION_TRIAL_DAYS=5
LICENSE_DURATION_DAYS=365
