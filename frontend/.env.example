# =========================================================================
# SwasthAI Frontend - Environment Configuration Template
# Copy this file to .env or .env.production and customize for your environment.
# =========================================================================

# API Base URL for SwasthAI backend REST API (with /api/v1 prefix)
VITE_API_BASE_URL=http://localhost:8087/api/v1

# Backend Base Host URL (without /api/v1 prefix, used for assets / verification)
VITE_BACKEND_BASE_URL=http://localhost:8087
